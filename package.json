{
  "name": "dsh-plugin-sync",
  "version": "2.7.1",
  "description": "Manual GitHub Gist plugin inventory sync with remove-then-install upgrades, local-only removal, an install log, and conflict-aware preview.",
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "sync",
    "github"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jijijitian/dsh-plugin-sync.git"
  },
  "homepage": "https://github.com/jijijitian/dsh-plugin-sync",
  "bugs": {
    "url": "https://github.com/jijijitian/dsh-plugin-sync/issues"
  }
}
